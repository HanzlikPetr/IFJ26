// Spravny program: PARAMLISTS
import ifj26.*

def answer: Int =
  print("answer\n")
  40

def add(left: Int)(middle: Int)(right: Int): Int = left + middle + right

def offset()(value: Int): Int = value + 1

@main def paramlistsExample(): Unit =
  val first = answer
  val second = answer
  val total = add(first)(second)(2)
  val result = offset()(total)
  print(result)
  print("\n")
