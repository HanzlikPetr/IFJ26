// Fibonacciho posloupnost (na vstupu 8 -> 0 1 1 2 3 5 8 13)
import ifj26.*

@main def main(): Unit =
    val n = readInt()
    var a = 0
    var b = 1
    for i <- 0 until n do
        if i > 0 then
            print(" ")
        print(a.toString)
        val next = a + b
        a = b
        b = next
    print("\n")
