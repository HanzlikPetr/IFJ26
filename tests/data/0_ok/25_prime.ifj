// test prvociselnosti (na vstupu 97 -> true)
import ifj26.*

def isPrime(n: Int): Boolean =
    if n < 2 then
        return false
    var d = 2
    var prime: Boolean = true
    while d * d <= n && prime do
        if n - (n / d) * d == 0 then
            prime = false
        d = d + 1
    prime

@main def main(): Unit =
    print(isPrime(readInt()))
    print("\n")
