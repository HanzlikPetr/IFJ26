// Spravny program: CONTROL - if jako vyraz a kombinace tvaru vetvi (spec 5.3)
import ifj26.*

@main def main(): Unit =
  var x = -5
  val absolute = if x < 0 then 0 - x else x
  val abs2 = if x < 0 then
    0 - x
  else
    x
  val abs3 = if x < 0 then 0 - x else
    x
  print(absolute)
  print("\n")
  print(abs2)
  print("\n")
  print(abs3)
  print("\n")
